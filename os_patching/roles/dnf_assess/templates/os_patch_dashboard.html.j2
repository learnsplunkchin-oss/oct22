<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ dnf_dashboard_title | default('RHEL OS Patching Assessment') | e }}</title>

<style>
:root {
  color-scheme: light;
  --bg: #f4f6fa;
  --panel: #ffffff;
  --text: #182230;
  --muted: #667085;
  --border: #dfe4ec;
  --navy: #172b4d;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 14px/1.45 Arial, Helvetica, sans-serif;
}
header {
  background: var(--navy);
  color: white;
  padding: 24px clamp(16px, 4vw, 44px);
}
header h1 { margin: 0 0 8px; font-size: clamp(24px, 3vw, 34px); }
header p { margin: 4px 0; color: #e0e8f5; }
main {
  max-width: 1600px;
  margin: auto;
  padding: 24px clamp(12px, 3vw, 32px) 40px;
}
.grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 18px;
}
.panel, .metric {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px;
  box-shadow: 0 2px 7px rgba(20, 35, 60, .04);
  min-width: 0;
}
.label { color: var(--muted); font-size: 13px; }
.value { font-size: 28px; font-weight: 700; margin-top: 5px; }
.hint, .muted { color: var(--muted); font-size: 12px; }
.section-title { font-size: 19px; margin: 0 0 12px; }
.charts {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
  gap: 18px;
  margin-bottom: 18px;
}
.chart-wrap { height: 360px; position: relative; }
.chart-wrap.small { height: 280px; }
.table-scroll { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td {
  text-align: left;
  padding: 10px;
  border-bottom: 1px solid var(--border);
  vertical-align: top;
}
th { background: #f8fafc; white-space: nowrap; }
.host-detail { margin-top: 16px; scroll-margin-top: 12px; }
.host-detail h3 { margin: 0 0 8px; }
.badge {
  display: inline-block;
  border-radius: 999px;
  padding: 4px 8px;
  font-size: 12px;
  font-weight: bold;
  background: #eef2f6;
}
.badge.pass { background: #dcfae6; color: #166534; }
.badge.remain { background: #fff0c2; color: #854d0e; }
.badge.failed, .badge.incomplete { background: #fee4e2; color: #912018; }
.package-columns {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}
.package-list {
  padding-left: 20px;
  overflow-wrap: anywhere;
}
.package-list li { margin: 5px 0; }
.host-link {
  border: 0;
  background: none;
  color: #3157a4;
  font: inherit;
  font-weight: bold;
  text-decoration: underline;
  cursor: pointer;
  padding: 0;
}
.tools {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}
.tools input, .tools select {
  font: inherit;
  padding: 9px;
  border: 1px solid #c9d2df;
  border-radius: 7px;
  background: white;
}
.tools input { flex: 1; min-width: 220px; }
.notice {
  padding: 12px 14px;
  border: 1px solid #f1d49a;
  background: #fff8e6;
  border-radius: 8px;
  margin: 14px 0;
}
footer { margin-top: 24px; color: var(--muted); font-size: 12px; }
@media(max-width: 900px) {
  .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .charts { grid-template-columns: 1fr; }
  .package-columns { grid-template-columns: 1fr; }
}
@media(max-width: 520px) {
  .grid { grid-template-columns: 1fr 1fr; gap: 8px; }
  .metric, .panel { padding: 12px; }
  .value { font-size: 23px; }
  .chart-wrap { height: 300px; }
}
@media print {
  body { background: white; }
  header { background: white; color: black; }
  .panel, .metric { box-shadow: none; break-inside: avoid; }
  .tools { display: none; }
}
</style>
</head>

<body>
<header>
  <h1>{{ dnf_dashboard_title | default('RHEL OS Patching Assessment') | e }}</h1>
  <p>Evidence-based RHEL DNF update-candidate assessment</p>
  <p>
    Generated: {{ assessment.generated_at | default('Unknown') | e }}
    |
    Collector: {{ assessment.collector_host | default('Unknown') | e }}
  </p>
</header>

<main>

  <!-- Executive metrics -->
  <section class="grid" aria-label="Assessment summary">
    <div class="metric">
      <div class="label">Hosts assessed</div>
      <div class="value">{{ assessment.summary.hosts | default(assessment.hosts | length) }}</div>
      <div class="hint">Expected fleet</div>
    </div>

    <div class="metric">
      <div class="label">PASS</div>
      <div class="value">{{ assessment.summary.pass | default(0) }}</div>
      <div class="hint">No post-check candidates reported</div>
    </div>

    <div class="metric">
      <div class="label">Updates remain</div>
      <div class="value">{{ assessment.summary.updates_remain | default(0) }}</div>
      <div class="hint">Post-check candidates reported</div>
    </div>

    <div class="metric">
      <div class="label">Attention required</div>
      <div class="value">{{ assessment.summary.attention_required | default(0) }}</div>
      <div class="hint">Remaining, failed, incomplete or review</div>
    </div>
  </section>

  <section class="grid" aria-label="Package candidate summary">
    <div class="metric">
      <div class="label">Pre-check candidates</div>
      <div class="value">{{ assessment.summary.precheck_candidates | default(0) }}</div>
      <div class="hint">
        Kernel {{ assessment.summary.precheck_kernel | default(0) }}
        · Regular {{ assessment.summary.precheck_regular | default(0) }}
      </div>
    </div>

    <div class="metric">
      <div class="label">Post-check candidates</div>
      <div class="value">{{ assessment.summary.postcheck_candidates | default(0) }}</div>
      <div class="hint">
        Kernel {{ assessment.summary.postcheck_kernel | default(0) }}
        · Regular {{ assessment.summary.postcheck_regular | default(0) }}
      </div>
    </div>

    <div class="metric">
      <div class="label">Resolved candidates</div>
      <div class="value">{{ assessment.summary.resolved_candidates | default(0) }}</div>
      <div class="hint">Present before, absent after</div>
    </div>

    <div class="metric">
      <div class="label">Remaining / new</div>
      <div class="value">
        {{ assessment.summary.remaining_candidates | default(0) }}
        /
        {{ assessment.summary.new_candidates | default(0) }}
      </div>
      <div class="hint">Comparison by package name</div>
    </div>
  </section>

  <!-- Fleet-wide charts -->
  <section class="charts">
    <div class="panel">
      <h2 class="section-title">Kernel vs Regular Candidates by Server</h2>
      <p class="muted">
        Each server has two stacked bars: pre-check and post-check.
        Each bar separates kernel and regular update candidates.
      </p>
      <div class="chart-wrap">
        <canvas id="fleetChart"></canvas>
      </div>
    </div>

    <div class="panel">
      <h2 class="section-title">Host Assessment Status</h2>
      <div class="chart-wrap small">
        <canvas id="statusChart"></canvas>
      </div>
    </div>
  </section>

  <!-- Host summary table -->
  <section class="panel">
    <h2 class="section-title">Host Summary</h2>

    <div class="tools">
      <input
        id="hostSearch"
        type="search"
        placeholder="Search host or status"
        aria-label="Search host or status">

      <select id="statusFilter" aria-label="Filter by status">
        <option value="">All statuses</option>
        <option value="PASS">PASS</option>
        <option value="UPDATES REMAIN">UPDATES REMAIN</option>
        <option value="PATCH FAILED">PATCH FAILED</option>
        <option value="INCOMPLETE">INCOMPLETE</option>
      </select>
    </div>

    <div class="table-scroll">
      <table id="hostTable">
        <thead>
          <tr>
            <th>Host</th>
            <th>Status</th>
            <th>Pre kernel</th>
            <th>Pre regular</th>
            <th>Post kernel</th>
            <th>Post regular</th>
            <th>Resolved</th>
            <th>Remaining</th>
            <th>New</th>
          </tr>
        </thead>

        <tbody>
        {% for host in assessment.hosts %}
          <tr
            data-host="{{ host.host | lower | e }}"
            data-status="{{ host.status | e }}">

            <td>
              <button
                class="host-link"
                onclick="showHostDetail('{{ host.host | e }}')"
                type="button">
                {{ host.host | e }}
              </button>
            </td>

            <td>
              <span class="badge {{ 'pass' if host.status == 'PASS' else 'remain' if host.status == 'UPDATES REMAIN' else 'failed' if host.status == 'PATCH FAILED' else 'incomplete' }}">
                {{ host.status | e }}
              </span>
            </td>

            <td>{{ host.patch_counts.precheck.kernel | default(0) }}</td>
            <td>{{ host.patch_counts.precheck.regular | default(0) }}</td>
            <td>{{ host.patch_counts.postcheck.kernel | default(0) }}</td>
            <td>{{ host.patch_counts.postcheck.regular | default(0) }}</td>
            <td>{{ host.comparison.resolved_count | default(0) }}</td>
            <td>{{ host.comparison.remaining_count | default(0) }}</td>
            <td>{{ host.comparison.new_count | default(0) }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <div class="notice">
    <strong>Interpretation:</strong>
    Kernel classification is based on RPM package names beginning with
    kernel-related prefixes or <code>kmod</code>. Candidate counts come from
    DNF evidence. A candidate disappearing after the check is not independent
    proof of successful installation or reboot. This report does not assign
    Tenable security severity.
  </div>

  <!-- Per-host drill-down -->
  <section id="hostDetails">
  {% for host in assessment.hosts %}
    <article class="panel host-detail" id="detail-{{ host.host | e }}">
      <h3>{{ host.host | e }}</h3>

      <p>
        <span class="badge {{ 'pass' if host.status == 'PASS' else 'remain' if host.status == 'UPDATES REMAIN' else 'failed' if host.status == 'PATCH FAILED' else 'incomplete' }}">
          {{ host.status | e }}
        </span>
        {{ host.reason | default('') | e }}
      </p>

      <div class="charts">
        <div>
          <h4>Pre-check / post-check candidates</h4>
          <div class="chart-wrap small">
            <canvas id="hostChart-{{ loop.index0 }}"></canvas>
          </div>
        </div>

        <div>
          <h4>Evidence metadata</h4>

          <p>
            OS:
            {{ host.postcheck.metadata.os_distribution
               | default(host.precheck.metadata.os_distribution)
               | default('Unknown') | e }}
            {{ host.postcheck.metadata.os_version
               | default(host.precheck.metadata.os_version)
               | default('') | e }}
          </p>

          <p>
            Pre-check status / rc:
            {{ host.precheck.metadata.status | default('UNKNOWN') | e }}
            /
            {{ host.precheck.metadata.dnf_rc | default('Unknown') }}
          </p>

          <p>
            Post-check status / rc:
            {{ host.postcheck.metadata.status | default('UNKNOWN') | e }}
            /
            {{ host.postcheck.metadata.dnf_rc | default('Unknown') }}
          </p>

          <p>
            Pre captured:
            {{ host.precheck.metadata.captured_at | default('Unknown') | e }}
          </p>

          <p>
            Post captured:
            {{ host.postcheck.metadata.captured_at | default('Unknown') | e }}
          </p>
        </div>
      </div>

      <div class="package-columns">
        <div>
          <h4>Resolved ({{ host.comparison.resolved_count }})</h4>
          <ul class="package-list">
          {% for package in host.comparison.resolved %}
            <li>
              {{ package.label | e }}
              <span class="muted">[{{ package.patch_type | e }}]</span>
            </li>
          {% else %}
            <li class="muted">None recorded</li>
          {% endfor %}
          </ul>
        </div>

        <div>
          <h4>Remaining ({{ host.comparison.remaining_count }})</h4>
          <ul class="package-list">
          {% for package in host.comparison.remaining %}
            <li>
              {{ package.label | e }}
              <span class="muted">[{{ package.patch_type | e }}]</span>
            </li>
          {% else %}
            <li class="muted">None recorded</li>
          {% endfor %}
          </ul>
        </div>

        <div>
          <h4>New ({{ host.comparison.new_count }})</h4>
          <ul class="package-list">
          {% for package in host.comparison.new %}
            <li>
              {{ package.label | e }}
              <span class="muted">[{{ package.patch_type | e }}]</span>
            </li>
          {% else %}
            <li class="muted">None recorded</li>
          {% endfor %}
          </ul>
        </div>
      </div>

      <h4>Pre-check candidates ({{ host.precheck.packages | length }})</h4>
      <ul class="package-list">
      {% for package in host.precheck.packages %}
        <li>
          {{ package.label | e }}
          <span class="muted">[{{ package.patch_type | e }}]</span>
        </li>
      {% else %}
        <li class="muted">No parsed package details</li>
      {% endfor %}
      </ul>

      <h4>Post-check candidates ({{ host.postcheck.packages | length }})</h4>
      <ul class="package-list">
      {% for package in host.postcheck.packages %}
        <li>
          {{ package.label | e }}
          <span class="muted">[{{ package.patch_type | e }}]</span>
        </li>
      {% else %}
        <li class="muted">No parsed package details</li>
      {% endfor %}
      </ul>
    </article>
  {% endfor %}
  </section>

  <footer>
    Generated from pre-check and post-check JSON evidence.
    Counts represent update candidates, not transaction history.
    This report does not assign security severity.
  </footer>
</main>

<script>
{{ chartjs_source | default('') }}

const report = {{ assessment | tojson }};
const hosts = report.hosts || [];

if (typeof Chart !== "undefined") {
  const labels = hosts.map(host => host.host);

  // Two stacked bars per server: pre-check and post-check.
  new Chart(document.getElementById("fleetChart"), {
    type: "bar",
    data: {
      labels,
      datasets: [
        {
          label: "Pre-check — Kernel",
          data: hosts.map(h => h.patch_counts?.precheck?.kernel || 0),
          stack: "pre"
        },
        {
          label: "Pre-check — Regular",
          data: hosts.map(h => h.patch_counts?.precheck?.regular || 0),
          stack: "pre"
        },
        {
          label: "Post-check — Kernel",
          data: hosts.map(h => h.patch_counts?.postcheck?.kernel || 0),
          stack: "post"
        },
        {
          label: "Post-check — Regular",
          data: hosts.map(h => h.patch_counts?.postcheck?.regular || 0),
          stack: "post"
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: "index", intersect: false },
      plugins: {
        legend: { position: "bottom" },
        tooltip: { mode: "index", intersect: false }
      },
      scales: {
        x: { stacked: true },
        y: {
          stacked: true,
          beginAtZero: true,
          ticks: { precision: 0 },
          title: {
            display: true,
            text: "Update candidate count"
          }
        }
      }
    }
  });

  // Fleet status breakdown.
  const statusOrder = [
    "PASS",
    "UPDATES REMAIN",
    "PATCH FAILED",
    "INCOMPLETE",
    "REVIEW"
  ];

  new Chart(document.getElementById("statusChart"), {
    type: "doughnut",
    data: {
      labels: statusOrder,
      datasets: [{
        label: "Hosts",
        data: statusOrder.map(
          status => hosts.filter(h => h.status === status).length
        )
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { position: "bottom" } }
    }
  });

  // Individual host chart.
  hosts.forEach((host, index) => {
    const canvas = document.getElementById(`hostChart-${index}`);
    if (!canvas) return;

    new Chart(canvas, {
      type: "bar",
      data: {
        labels: ["Pre-check", "Post-check"],
        datasets: [
          {
            label: "Kernel",
            data: [
              host.patch_counts?.precheck?.kernel || 0,
              host.patch_counts?.postcheck?.kernel || 0
            ],
            stack: "packages"
          },
          {
            label: "Regular",
            data: [
              host.patch_counts?.precheck?.regular || 0,
              host.patch_counts?.postcheck?.regular || 0
            ],
            stack: "packages"
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: "bottom" } },
        scales: {
          x: { stacked: true },
          y: {
            stacked: true,
            beginAtZero: true,
            ticks: { precision: 0 }
          }
        }
      }
    });
  });
} else {
  document.querySelectorAll(".charts").forEach(element => {
    const notice = document.createElement("p");
    notice.className = "notice";
    notice.textContent =
      "Chart.js bundle not found. Place chart.umd.min.js in " +
      "roles/dnf_assess/files/ to enable charts.";
    element.appendChild(notice);
  });
}

function showHostDetail(hostName) {
  const detail = document.getElementById("detail-" + hostName);

  if (detail) {
    detail.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  }
}

function filterHosts() {
  const search = document.getElementById("hostSearch")
    .value.toLowerCase().trim();

  const selectedStatus = document.getElementById("statusFilter").value;

  document.querySelectorAll("#hostTable tbody tr").forEach(row => {
    const host = row.dataset.host || "";
    const status = row.dataset.status || "";

    const matchesSearch =
      host.includes(search) || status.toLowerCase().includes(search);

    const matchesStatus =
      !selectedStatus || status === selectedStatus;

    row.hidden = !(matchesSearch && matchesStatus);
  });
}

document.getElementById("hostSearch")
  .addEventListener("input", filterHosts);

document.getElementById("statusFilter")
  .addEventListener("change", filterHosts);
</script>
</body>
</html>
